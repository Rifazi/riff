# Copy this file to backend/.env and fill in your own values.
# This is intentionally separate from any target repo's own .env (which
# holds its own app/stage secrets) — the harness must never read that file.
#
# Provider API keys, per-role model choice, target apps, and per-app prompt
# overrides are NOT configured here — set them from the running app's
# Settings and Apps pages instead (saved to backend/local-settings.json,
# backend/local-apps.json, and backend/local-prompts.json, so they can be
# changed without a restart and without editing files by hand).

# Optional: only used once, to seed your first app (named "Customer-EDI") on
# a brand-new install with no backend/local-apps.json yet — an absolute path
# to a Customer-EDI checkout. Every app after that (including changing this
# one's repo path later) is managed from the Apps page instead. Safe to
# leave unset if you'd rather add your first app from the UI.
TARGET_REPO_ROOT=/Users/you/Customer-EDI

# Optional: override the port the backend listens on (default 4319)
# HARNESS_PORT=4319
